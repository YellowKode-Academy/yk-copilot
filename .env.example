# Proxy port — serves the proxy API and dashboard at http://localhost:9999
PROXY_PORT=9999

# Ollama (leave as-is when using docker compose)
OLLAMA_API_URL=http://yk_ollama:11434

# Playwright MCP (leave as-is when using docker compose)
PLAYWRIGHT_MCP_URL=http://yk_playwright:8931

# Fast model: used for simple / short requests
MODEL_FAST=qwen2.5-coder:7b

# Smart model: used for complex / multi-turn / tool-heavy requests
MODEL_SMART=qwen2.5-coder:14b

# ── Claude Code setup ──────────────────────────────────────────────────────────
# After starting docker compose, set these in your terminal and run claude:
#
#   export ANTHROPIC_BASE_URL=http://localhost:9999
#   export ANTHROPIC_API_KEY=ollama
#   claude
#
# Or add to your shell profile (~/.zshrc / ~/.bashrc) so it's always active.
