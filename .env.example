# Proxy port — serves the proxy API and dashboard at http://localhost:9999
PROXY_PORT=9999

# ── Ollama ────────────────────────────────────────────────────────────────────
#
# Option A (recommended): Ollama native on the host — uses your GPU
#   Install from https://ollama.com, then:
#     ollama pull qwen2.5-coder:7b && ollama pull gemma4:e4b
#   Start the stack with: docker compose up -d
#   Requires OLLAMA_HOST=0.0.0.0 on the host so the container can reach it.
OLLAMA_API_URL=http://host.docker.internal:11434
#
# Option B: Ollama inside Docker — CPU-only on Mac/Windows, GPU on Linux
#   Start the stack with: docker compose --profile with-ollama up -d
#   and set: OLLAMA_API_URL=http://yk_ollama:11434

# Playwright MCP (leave as-is when using docker compose)
PLAYWRIGHT_MCP_URL=http://yk_playwright:8931

# ── Models ────────────────────────────────────────────────────────────────────
# Fast model: simple / short requests with no tools
MODEL_FAST=qwen3-coder:30b

# Smart model: complex / multi-turn / tool-heavy requests.
# Claude Code always sends tools, so in practice this model handles everything.
# Pick one that fits your VRAM — 14b (~9 GB) does not fit an 8 GB card and will
# spill to CPU. Only raise this if you have 12 GB of VRAM or more.
MODEL_SMART=qwen3-coder:30b

# Vision model: describes images before passing context to the code model
MODEL_VISION=gemma3:4b

# ── Context window ────────────────────────────────────────────────────────────
# Ollama defaults to 4096 tokens, which silently truncates Claude Code's system
# prompt and tool definitions before the model ever sees your request. 32768 is
# the working minimum. Drop to 16384 if you run out of VRAM.
NUM_CTX=24576

# ── Claude Code setup ──────────────────────────────────────────────────────────
# After starting docker compose:
#
#   yk-copilot on     (registers via scripts/install.ps1 or scripts/install.sh)
#
# or by hand:
#   export ANTHROPIC_BASE_URL=http://localhost:9999
#   export ANTHROPIC_API_KEY=ollama
#   claude
